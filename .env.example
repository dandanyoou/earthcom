# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000
RUFF_CACHE_DIR=/tmp/pangaea/ruff
PYTHONPYCACHEPREFIX=/tmp/pangaea/pycache

# Local stateful services
POSTGRES_USER=pangaea
POSTGRES_PASSWORD=pangaea-local-only
POSTGRES_DB=pangaea
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=pangaea
MINIO_ROOT_PASSWORD=pangaea-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgresql+psycopg://pangaea:pangaea-local-only@postgres:5432/pangaea
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=pangaea-private
OBJECT_STORAGE_ACCESS_KEY=pangaea
OBJECT_STORAGE_SECRET_KEY=pangaea-local-only

# Safe feature defaults
AI_MODE=stub
DEPOSIT_PROVIDER=sandbox
DEPOSIT_PRODUCTION_ENABLED=false
DEPOSIT_FORFEITURE_ENABLED=false

# Development-only authentication values; replace all secrets in production.
# Production: replace this with the output of `openssl rand -base64 32`.
JWT_SIGNING_KEY=pangaea-local-development-signing-key
RATE_LIMIT_PEPPER=pangaea-local-development-rate-limit-pepper
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=pangaea_refresh
REFRESH_COOKIE_SECURE=false
